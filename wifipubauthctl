CONF = "/etc/%s/%s.conf" % (NOM, NOM)
DOSSIER_SURCHARGES = "/etc/%s/conf.d" % NOM
CONF_LOCALE = DOSSIER_SURCHARGES + "/local.conf"

COULEURS = sys.stdout.isatty() and not os.environ.get("NO_COLOR") and os.environ.get("TERM", "dumb") != "dumb"
VERT, ROUGE, RAZ = ("\033[32m", "\033[31m", "\033[0m") if COULEURS else ("", "", "")
CONTROLE = re.compile(r"[\x00-\x1f\x7f]")


def propre(texte):
    return CONTROLE.sub("", str(texte))


def ok(texte):
    print("%s[  OK  ]%s %s" % (VERT, RAZ, propre(texte)))


def echec(texte, code=1):
    print("%s[FAILED]%s %s" % (ROUGE, RAZ, propre(texte)), file=sys.stderr)
    sys.exit(code)


def application():
    sys.path.insert(0, DOSSIER_CODE)
    return importlib.import_module(NOM)


def exiger_root():
    if os.geteuid() != 0:
        echec("droits root requis")


# --- Services ---------------------------------------------------------------------------

ACTIONS = {
    "start":   ("Démarrage", "active"),
    "restart": ("Redémarrage", "active"),
    "stop":    ("Arrêt", "inactive"),
    "enable":  ("Activation au démarrage et démarrage", "active"),
    "disable": ("Désactivation au démarrage et arrêt", "inactive"),
}


def piloter(action):
    """Action systemd sur le service, puis vérification de l'état obtenu."""
    unite = NOM + ".service"
    libelle, attendu = ACTIONS[action]
    arguments = [action, "--now", unite] if action in ("enable", "disable") else [action, unite]
    r = subprocess.run(["systemctl", *arguments], capture_output=True, text=True)
    if r.returncode == 0 and attendu == "active":
        time.sleep(2)   # un échec au lancement survient dans les premières secondes
    etat_actif = subprocess.run(["systemctl", "is-active", unite], capture_output=True, text=True).stdout.strip()
    if r.returncode != 0 or etat_actif != attendu:
        detail = propre(r.stderr.strip().splitlines()[-1]) if r.stderr.strip() else "état : %s" % etat_actif
        echec("%s de %s : %s (journalctl -u %s -n 50)" % (libelle, unite, detail, NOM))
    ok("%s de %s" % (libelle, unite))
    if action in ("start", "restart", "enable") and freeradius_a_jour() is False:
        redemarrer_freeradius()


def redemarrer_freeradius():
    """Redémarre FreeRADIUS, dont la configuration a changé depuis son démarrage,
    après avoir vérifié qu'elle est valide."""
    if subprocess.run(["freeradius", "-XC"], capture_output=True).returncode != 0:
        echec("freeradius : configuration modifiée mais invalide, non redémarré (%sctl check)" % NOM)
    r = subprocess.run(["systemctl", "restart", "freeradius.service"], capture_output=True, text=True)
    time.sleep(2)
    actif = subprocess.run(["systemctl", "is-active", "freeradius.service"],
                           capture_output=True, text=True).stdout.strip()
    if r.returncode != 0 or actif != "active":
        echec("Redémarrage de freeradius.service : %s (journalctl -u freeradius -n 50)"
              % (propre(r.stderr.strip().splitlines()[-1]) if r.stderr.strip() else "état : " + actif))
    ok("Redémarrage de freeradius.service (configuration modifiée)")


def etat(texte, valide):
    """Ligne d'état en lecture seule : « objet : valide|invalide ». """
    couleur = VERT if valide else ROUGE
    objet, _, reste = texte.partition(" : ")
    print("%s : %s%s%s" % (propre(objet), couleur, propre(reste), RAZ))


def cmd_check(_):
    exiger_root()
    code = 0
    r = subprocess.run(["runuser", "-u", NOM, "--", "/usr/bin/python3", "-I",
                        "%s/%s.py" % (DOSSIER_CODE, NOM), "--config", CONF, "--verifier"],
                       capture_output=True, text=True)
    lignes = [l for l in r.stderr.splitlines() if l and l != "configuration valide"]
    if r.returncode == 0:
        etat("%s : configuration valide" % NOM, True)
        for ligne in lignes:
            print("  " + propre(ligne))
    else:
        etat("%s : configuration invalide" % NOM, False)
        for ligne in lignes:
            print("  " + propre(ligne))
        code = 1
    r = subprocess.run(["freeradius", "-XC"], capture_output=True, text=True)
    sortie = r.stdout + r.stderr
    site = re.search(r"^server %s \{ # from file (\S+)" % re.escape(NOM), sortie, re.M)
    if r.returncode != 0:
        etat("freeradius : configuration invalide", False)
        for ligne in sortie.splitlines()[-8:]:
            print("  " + propre(ligne))
        code = 1
    elif not site:
        etat("freeradius : serveur virtuel %s absent de sites-enabled" % NOM, False)
        code = 1
    else:
        etat("freeradius : configuration valide (%s)" % site.group(1), True)
        code |= verifier_freeradius_en_service(site.group(1))
    sys.exit(code)


# --- FreeRADIUS en service ------------------------------------------------------------

DOSSIER_FR = "/etc/freeradius/3.0"


def debut_processus(pid):
    """Heure (epoch) de démarrage d'un processus, d'après /proc."""
    with open("/proc/%d/stat" % pid) as f:
        debut = int(f.read().rsplit(")", 1)[1].split()[19])   # champ 22 : starttime
    with open("/proc/stat") as f:
        amorcage = next(int(l.split()[1]) for l in f if l.startswith("btime "))
    return amorcage + debut / os.sysconf("SC_CLK_TCK")


def derniere_modification_freeradius():
    """Date de la dernière modification de la configuration active de
    FreeRADIUS : liens et fichiers de sites-enabled et mods-enabled,
    radiusd.conf, clients.conf."""
    dates = []
    for dossier in ("sites-enabled", "mods-enabled"):
        chemin = os.path.join(DOSSIER_FR, dossier)
        dates.append(os.stat(chemin).st_mtime)
        for entree in os.listdir(chemin):
            for suivre in (False, True):
                try:
                    dates.append(os.stat(os.path.join(chemin, entree), follow_symlinks=suivre).st_mtime)
                except OSError:
                    pass
    for fichier in ("radiusd.conf", "clients.conf"):
        try:
            dates.append(os.stat(os.path.join(DOSSIER_FR, fichier)).st_mtime)
        except OSError:
            pass
    return max(dates)


def freeradius_a_jour():
    """None si FreeRADIUS n'est pas actif, sinon True si le processus en
    service a démarré après la dernière modification de sa configuration."""
    r = subprocess.run(["systemctl", "show", "--property=MainPID", "--value", "freeradius.service"],
                       capture_output=True, text=True)
    try:
        pid = int(r.stdout.strip())
        if pid <= 0:
            return None
        return debut_processus(pid) >= derniere_modification_freeradius()
    except (ValueError, OSError, StopIteration):
        return None


def ecoute_du_site(fichier):
    """(adresse, port) d'écoute du serveur virtuel du service, lus dans son fichier."""
    with open(fichier, encoding="utf-8") as f:
        texte = f.read()
    serveur = re.search(r"^\s*server\s+%s\s*\{(.*)" % re.escape(NOM), texte, re.M | re.S)
    ecoute = re.search(r"listen\s*\{([^}]*)\}", serveur.group(1) if serveur else "")
    if not ecoute:
        return None
    adresse = re.search(r"^\s*ipaddr\s*=\s*(\S+)", ecoute.group(1), re.M)
    port = re.search(r"^\s*port\s*=\s*(\d+)", ecoute.group(1), re.M)
    return (adresse.group(1) if adresse else "*", int(port.group(1)) if port else 1812)


def freeradius_ecoute(adresse, port):
    """True si un processus freeradius écoute en UDP sur adresse:port (une
    écoute sur toutes les adresses ne compte que si adresse vaut *)."""
    toutes = ("*", "0.0.0.0", "::")
    r = subprocess.run(["ss", "-H", "-u", "-l", "-n", "-p"], capture_output=True, text=True)
    for ligne in r.stdout.splitlines():
        morceaux = ligne.split()
        if len(morceaux) < 4 or '"freeradius"' not in ligne:
            continue
        hote, _, port_local = morceaux[3].rpartition(":")
        hote = hote.strip("[]").split("%")[0]
        if port_local == str(port) and (hote == adresse or (adresse in toutes and hote in toutes)):
            return True
    return False


def conflits_ecoute(fichier_site, port):
    """Autres sites activés qui écoutent en authentification sur toutes les
    adresses et le même port : FreeRADIUS ne peut alors pas démarrer."""
    conflits = []
    dossier = os.path.join(DOSSIER_FR, "sites-enabled")
    for nom in sorted(os.listdir(dossier)):
        chemin = os.path.join(dossier, nom)
        if os.path.realpath(chemin) == os.path.realpath(fichier_site):
            continue
        try:
            with open(chemin, encoding="utf-8", errors="replace") as f:
                texte = re.sub(r"#.*", "", f.read())
        except OSError:
            continue
        for bloc in re.findall(r"listen\s*\{([^}]*)\}", texte):
            type_ = re.search(r"^\s*type\s*=\s*(\S+)", bloc, re.M)
            adresse = re.search(r"^\s*ip(?:v4|v6)?addr\s*=\s*(\S+)", bloc, re.M)
            port_bloc = re.search(r"^\s*port\s*=\s*(\d+)", bloc, re.M)
            port_effectif = int(port_bloc.group(1)) if port_bloc else 0
            if type_ and type_.group(1) == "auth" and adresse and adresse.group(1) == "*" \
                    and (port_effectif or 1812) == port:
                conflits.append(nom)
                break
    return conflits


def verifier_freeradius_en_service(fichier_site):
    """FreeRADIUS en service : pas de conflit d'écoute, actif, configuration
    chargée, écoute du site. Renvoie 0 si tout va bien, 1 sinon."""
    ecoute = ecoute_du_site(fichier_site)
    if ecoute and ecoute[0] not in ("*", "0.0.0.0", "::"):
        conflits = conflits_ecoute(fichier_site, ecoute[1])
        if conflits:
            etat("freeradius : %s écoute sur toutes les adresses, port %d : conflit avec %s "
                 "(lien à retirer : %s)" % (", ".join(conflits), ecoute[1], NOM,
                                             ", ".join("sites-enabled/" + c for c in conflits)), False)
            return 1
    a_jour = freeradius_a_jour()
    if a_jour is None:
        etat("freeradius : service arrêté", False)
        return 1
    if not a_jour:
        etat("freeradius : configuration modifiée depuis le démarrage, redémarrage nécessaire "
             "(%sctl restart)" % NOM, False)
        return 1
    if ecoute and not freeradius_ecoute(*ecoute):
        etat("freeradius : n'écoute pas sur %s:%d" % ecoute, False)
        return 1
    etat("freeradius : en service%s" % (", écoute sur %s:%d" % ecoute if ecoute else ""), True)
    return 0


def cmd_status(_):
    """État résumé de chaque service ; état complet (systemctl status) des
    services en défaut seulement."""
    code = 0
    for unite in (NOM + ".service", "freeradius.service"):
        r = subprocess.run(["systemctl", "show", "--property=LoadState,ActiveState,SubState,UnitFileState",
                            unite], capture_output=True, text=True)
        p = dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)
        actif = p.get("ActiveState", "inconnu")
        demarrage = p.get("UnitFileState") or "inconnu"
        bon = p.get("LoadState") == "loaded" and actif == "active" and demarrage == "enabled"
        etat("%s : %s (%s), %s" % (unite, actif, p.get("SubState", "?"), demarrage), bon)
        if not bon:
            code = 3
            sys.stdout.flush()
            subprocess.call(["systemctl", "status", unite])
    sys.exit(code)


# --- Configuration ----------------------------------------------------------------------

def lire_secret(nom, essais=3):
    """Saisie masquée avec confirmation. L'entrée en attente (texte collé sur
    plusieurs lignes) est vidée avant chaque invite."""
    if not (sys.stdin.isatty() and sys.stderr.isatty()):
        echec("%s : saisie interactive obligatoire (terminal requis)" % nom)

    def invite(texte):
        termios.tcflush(sys.stdin.fileno(), termios.TCIFLUSH)
        try:
            return getpass.getpass(texte)
        except (EOFError, KeyboardInterrupt):
            print(file=sys.stderr)
            echec("%s : saisie interrompue" % nom)

    for _ in range(essais):
        premiere = invite("%s : " % nom)
        if not premiere or CONTROLE.search(premiere) or '"' in premiere or "\\" in premiere:
            print("%s : valeur vide, ou avec guillemet, \\ ou caractère de contrôle" % nom, file=sys.stderr)
            continue
        if invite("%s (confirmation) : " % nom) == premiere:
            return premiere
        print("%s : les deux saisies diffèrent" % nom, file=sys.stderr)
    echec("%s : abandon après %d essais" % (nom, essais))


def ecrire(app, mot, valeur):
    """Écrit « Nom "valeur" » dans conf.d : remplace la ligne existante du mot-clé
    (ou de son ancien nom) dans le fichier où elle se trouve, sinon ajoute à local.conf."""
    nom = app.NOMS[mot]
    anciens = {a for a, n in app.ALIAS.items() if n == mot}
    ligne_neuve = '%s "%s"\n' % (nom, valeur)
    cible, lignes, index = CONF_LOCALE, None, None
    for fichier in sorted(glob.glob(DOSSIER_SURCHARGES + "/*.conf")):
        with open(fichier, encoding="utf-8") as f:
            contenu = f.readlines()
        for i, ligne in enumerate(contenu):
            try:
                morceaux = shlex.split(ligne, comments=True)
            except ValueError:
                continue
            if morceaux and (morceaux[0].lower() == mot or morceaux[0].lower() in anciens):
                cible, lignes, index = fichier, contenu, i
                break
        if lignes is not None:
            break
    if lignes is None:
        if os.path.exists(CONF_LOCALE):
            with open(CONF_LOCALE, encoding="utf-8") as f:
                lignes = f.readlines()
            if lignes and not lignes[-1].endswith("\n"):
                lignes[-1] += "\n"
        else:
            lignes = []
        lignes.append(ligne_neuve)
    else:
        lignes[index] = ligne_neuve
    ecrire_fichier(cible, lignes)
    return cible


def ecrire_fichier(cible, lignes):
    """Écriture atomique, propriétaire root:NOM, droits 0640."""
    gid = grp.getgrnam(NOM).gr_gid
    descripteur, temporaire = tempfile.mkstemp(dir=os.path.dirname(cible), prefix=".wpa-")
    try:
        with os.fdopen(descripteur, "w", encoding="utf-8") as f:
            f.writelines(lignes)
        os.chown(temporaire, 0, gid)
        os.chmod(temporaire, 0o640)
        os.replace(temporaire, cible)
    except BaseException:
        os.unlink(temporaire)
        raise


def cmd_set(args):
    exiger_root()
    app = application()
    mot = args.parametre.lower()
    if mot in app.ALIAS:
        echec("%s : mot-clé obsolète, utiliser %s" % (args.parametre, app.NOMS[app.ALIAS[mot]]), 2)
    if mot in app.OBSOLETES:
        echec("%s : mot-clé obsolète, remplacé par %s" % (args.parametre, app.OBSOLETES[mot][1]), 2)
    if mot not in app.MOTS_CLES:
        echec("%s : mot-clé inconnu" % args.parametre, 2)
    nom = app.NOMS[mot]
    if args.genkey and mot != "pseudonymization":
        echec("--genkey : seulement avec Pseudonymization on", 2)

    if mot in app.SECRETS:
        if args.valeur is not None:
            echec("%s : secret, à saisir de façon interactive : %sctl set %s" % (nom, NOM, nom), 2)
        valeur = lire_secret(nom)
    elif args.valeur is None:
        echec("%s : valeur manquante" % nom, 2)
    else:
        valeur = args.valeur
    if not valeur or CONTROLE.search(valeur) or '"' in valeur or "\\" in valeur:
        echec("%s : valeur vide, ou avec guillemet, \\ ou caractère de contrôle" % nom, 2)
    try:
        converti = app.MOTS_CLES[mot][1](valeur)
    except ValueError as e:
        echec("%s : %s" % (nom, e), 2)

    if mot == "pseudonymization" and converti:
        actuelles = app.lire_valeurs(CONF)
        if args.genkey:
            fichier = ecrire(app, "fingerprintkey", secrets.token_hex(32))
            ok("FingerprintKey générée (%s)" % fichier)
        elif not actuelles.get("fingerprintkey"):
            echec("FingerprintKey absente : %sctl set Pseudonymization on --genkey" % NOM, 2)

    fichier = ecrire(app, mot, valeur)
    ok("%s %s(%s)" % (nom, "" if mot in app.SECRETS else valeur + " ", fichier))


